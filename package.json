{
  "name": "martinez-place",
  "version": "0.2.0",
  "description": "Interactive resume of Jorge Martínez Ortiz, built with React, Vite, Tailwind and Sanity, with a Storybook component library",
  "author": "Jorge Martínez Ortiz",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nezor11/martinez-place"
  },
  "bugs": {
    "url": "https://github.com/nezor11/martinez-place/issues"
  },
  "private": true,
  "dependencies": {
    "@sanity/block-content-to-html": "^2.0.0",
    "@sanity/image-url": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "dompurify": "^3.4.14",
    "nanoid": "^5.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-obfuscate": "^3.6.9",
    "react-player": "^2.16.0",
    "swiper": "^11.1.1",
    "tailwind-merge": "^3.0.0"
  },
  "scripts": {
    "build-storybook-and-copy-readme": "storybook build --docs && node copy-readme-files.js",
    "copy-readme-files": "node copy-readme-files.js",
    "delete-readme-files": "node delete-readme-files.js",
    "fetch-resume": "node scripts/fetch-resume.mjs",
    "dev": "node scripts/fetch-resume.mjs && vite",
    "build": "yarn fetch-resume --strict && yarn build:client && yarn build:ssr && yarn prerender",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "build-storybook-docs": "storybook build --docs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "biome lint",
    "format": "biome format",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "lighthouse": "lhci autorun --config=lighthouserc.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^1.9.4",
    "@chromatic-com/storybook": "^5.3.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/dompurify": "^3.0.5",
    "@types/jsdom": "^30",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@types/react-syntax-highlighter": "^15.5.11",
    "@vitejs/plugin-react": "^5.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-syntax-highlighter": "^15.4.3",
    "sass": "^1.104.0",
    "sharp": "^0.35.4",
    "storybook": "^10.6.0",
    "storybook-dark-mode": "^5.0.0",
    "svgo": "^3.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6",
    "vite": "^8",
    "vite-plugin-image-optimizer": "^1.1.7",
    "vite-tsconfig-paths": "^5"
  },
  "resolutions": {
    "jackspeak": "2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "strip-ansi": "6.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0"
  }
}
