{
  "name": "intro-storybook-react-template",
  "version": "0.2.0",
  "description": "Starter template to get up and running quickly with React and Storybook",
  "author": "Chromatic <https://chromatic.com/>",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chromaui/intro-storybook-react-template"
  },
  "bugs": {
    "url": "https://github.com/chromaui/intro-storybook-react-template/issues"
  },
  "private": true,
  "dependencies": {
    "@sanity/block-content-to-html": "^2.0.0",
    "@sanity/client": "^6.13.3",
    "@sanity/image-url": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "dompurify": "^3.1.7",
    "nanoid": "^5.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.4",
    "react-html-parser": "^2.0.2",
    "react-obfuscate": "^3.6.9",
    "react-player": "^2.16.0",
    "styled-components": "^6.1.8",
    "swiper": "^11.1.1",
    "tailwind-merge": "^2.1.0"
  },
  "scripts": {
    "build-storybook-and-copy-readme": "storybook build --docs && node copy-readme-files.js",
    "copy-readme-files": "node copy-readme-files.js",
    "delete-readme-files": "node delete-readme-files.js",
    "dev": "vite",
    "build": "vite build",
    "build-storybook-docs": "storybook build --docs",
    "preview": "vite preview",
    "storybook": "concurrently 'yarn:watch:*'",
    "watch:storybook": "storybook dev -p 6006",
    "watch:tailwind": "npx tailwindcss -i ./src/tailwind-input.css -o ./src/styles/tailwind.css --watch",
    "build-storybook": "storybook build",
    "lint": "biome lint",
    "format": "biome format",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@chromatic-com/storybook": "^2.0.2",
    "@storybook/addon-docs": "^8.3.5",
