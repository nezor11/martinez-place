    "tailwindcss": "^3.4.1",
    "typescript": "~5.6",
    "vite": "^4.2.0",
    "vite-plugin-image-optimizer": "^1.1.7",
    "vite-plugin-require": "^1.1.14",
    "vite-tsconfig-paths": "^4.3.1"
  },
  "resolutions": {
    "jackspeak": "2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "strip-ansi": "6.0.0"
  },
  "packageManager": "yarn@4.1.1"
}
